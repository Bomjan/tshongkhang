{
  "info": {
    "name": "Tshongkhang · Sprint 1–2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Seller accounts, product ownership, public storefront and guest checkout. Enable Postman cookies. Clear checkout_key to place a separate order."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "seller_email",
      "value": "review-new@example.com"
    },
    {
      "key": "seller_password",
      "value": "semester-demo-password"
    },
    {
      "key": "seller_id",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "checkout_key",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Seller account",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_name\": \"Pema Store\",\n  \"email\": \"{{seller_email}}\",\n  \"password\": \"{{seller_password}}\",\n  \"location\": \"Thimphu\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([201]); });",
                  "if (pm.response.code < 300) pm.collectionVariables.set('seller_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{seller_email}}\",\n  \"password\": \"{{seller_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "if (pm.response.code < 300) pm.collectionVariables.set('seller_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "My session",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit shop profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/sellers/{{seller_id}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Local Bhutanese goods\",\n  \"location\": \"Paro\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([204]); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products and storefront",
      "item": [
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Red rice 1kg\",\n  \"description\": \"Local rice\",\n  \"price\": \"125.50\",\n  \"stock\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([201]); });",
                  "if (pm.response.code < 300) pm.collectionVariables.set('product_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Public shops",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/sellers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Public store profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/sellers/{{seller_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Public products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/products?seller_id={{seller_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Public product details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/products/{{product_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/products/{{product_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Red rice 1kg\",\n  \"description\": \"Local rice\",\n  \"price\": \"130.00\",\n  \"stock\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/products/{{product_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([204]); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Guest checkout",
      "item": [
        {
          "name": "Place guest order (repeat safely)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/stores/{{seller_id}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"checkout_key\": \"{{checkout_key}}\",\n  \"customer_name\": \"Sonam\",\n  \"customer_phone\": \"17123456\",\n  \"customer_address\": \"Changzamtog, Thimphu\",\n  \"items\": [\n    {\n      \"product_id\": \"{{product_id}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "if (pm.response.code < 300) pm.collectionVariables.set('order_id', pm.response.json().id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('checkout_key')) pm.collectionVariables.set('checkout_key', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
